diff -ruN a/tools/verify_saves.py b/tools/verify_saves.py
--- a/tools/verify_saves.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tools/verify_saves.py	2026-11-24 09:45:05.604094799 +0000
@@ -0,0 +1,47 @@
+#!/usr/bin/env python3
+"""Reference reader for RavenDroid's native-saves.bin (RAVSAVE1), mirroring SaveStore::load in
+native-runtime/src/saves.rs. Usage: verify_saves.py FILE [--list]   |   --make FILE  (fresh fixture)"""
+import hashlib, json, struct, sys
+MAX_FILE, MAX_TOTAL, MAX_NODES, MAX_INDEX = 8*1024*1024, 32*1024*1024, 1024, 1024*1024
+
+def valid(p):
+    return (p == "/idbfs" or p.startswith("/idbfs/")) and len(p) <= 4096 and "\\" not in p and "\0" not in p \
+        and all(x not in ("", ".", "..") for x in p[1:].split("/"))
+
+def load(path):
+    b = open(path, "rb").read(); n = len(b)
+    assert 44 <= n <= MAX_TOTAL + MAX_INDEX + 44, "size"
+    assert b[:8] == b"RAVSAVE1", "magic"
+    isz = struct.unpack("<I", b[8:12])[0]
+    assert isz <= MAX_INDEX and isz + 44 <= n, "index size"
+    meta = json.loads(b[12:12+isz]); assert 0 < len(meta) <= MAX_NODES, "nodes"
+    for m in meta: assert set(m) == {"path", "directory", "bytes"}, "unknown field"   # deny_unknown_fields
+    total = 0; pos = 12 + isz; entries = {}
+    for m in meta:
+        assert valid(m["path"]) and m["bytes"] <= MAX_FILE and (not m["directory"] or m["bytes"] == 0), "entry " + m["path"]
+        total += m["bytes"]; assert total <= MAX_TOTAL, "quota"
+    assert n == 12 + isz + total + 32, "payload length"
+    for m in meta:
+        assert m["path"] not in entries, "dup"
+        entries[m["path"]] = (m["directory"], b[pos:pos+m["bytes"]]); pos += m["bytes"]
+    assert hashlib.sha256(b[:-32]).digest() == b[-32:], "checksum"
+    assert entries.get("/idbfs", (False,))[0], "root"
+    for p in entries:
+        if p != "/idbfs": assert entries.get(p.rsplit("/", 1)[0], (False,))[0], "parent of " + p
+    return entries
+
+def make(path, entries):
+    """Writer using serde_json's compact style and the Rust sorted-path order."""
+    items = sorted(entries.items())
+    idx = json.dumps([{"path": p, "directory": d, "bytes": len(v)} for p, (d, v) in items], separators=(",", ":"), ensure_ascii=False).encode()
+    body = b"RAVSAVE1" + struct.pack("<I", len(idx)) + idx + b"".join(v for _, (_, v) in items)
+    open(path, "wb").write(body + hashlib.sha256(body).digest())
+
+if __name__ == "__main__":
+    if sys.argv[1] == "--make":
+        make(sys.argv[2], {"/idbfs": (True, b""), "/idbfs/profile": (True, b""), "/idbfs/profile/SaveData": (True, b""),
+                           "/idbfs/profile/SaveData/settings.dat": (False, b"keep-me")})
+        print("fixture written"); sys.exit()
+    e = load(sys.argv[1]); print("VALID:", len(e), "nodes,", sum(len(v) for _, v in e.values()), "bytes")
+    if "--list" in sys.argv:
+        for p, (d, v) in sorted(e.items()): print(("d " if d else "f ") + p + ("" if d else f" ({len(v)})"))
