+package dev.ravenfield.nativehost;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.StandardCopyOption;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Map;
+import java.util.TreeMap;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipInputStream;
+
+/**
+ * Copies a mod ZIP into the game's /idbfs save snapshot (native-saves.bin, format RAVSAVE1).
+ * Limits and validation mirror native-runtime/src/saves.rs; the file is replaced atomically and
+ * only when the whole import fits. Must not run while a native session is active.
+ */
+final class ModImporter {
+    static final int MAX_FILE = 8 * 1024 * 1024, MAX_TOTAL = 32 * 1024 * 1024, MAX_NODES = 1024, MAX_INDEX = 1024 * 1024;
+    private static final byte[] MAGIC = "RAVSAVE1".getBytes(StandardCharsets.US_ASCII);
+    private static final String ROOT = "/idbfs";
+    private static final int MAX_ZIP_ENTRIES = 4000;
+
+    static final class Entry {
+        final boolean directory; final byte[] data;
+        Entry(boolean directory, byte[] data) { this.directory = directory; this.data = data; }
+    }
+    static final class Result {
+        final String modsRoot, modName; final int files; final long bytes;
+        Result(String modsRoot, String modName, int files, long bytes) { this.modsRoot = modsRoot; this.modName = modName; this.files = files; this.bytes = bytes; }
+    }
+    private ModImporter() {}
+
+    /** Loads the snapshot; a missing file yields just the root directory, like the Rust store. */
+    static TreeMap<String, Entry> load(File snapshot) throws IOException {
+        TreeMap<String, Entry> entries = new TreeMap<>();
+        if (!snapshot.exists()) { entries.put(ROOT, new Entry(true, new byte[0])); return entries; }
+        long length = snapshot.length();
+        if (length < 44 || length > (long) MAX_TOTAL + MAX_INDEX + 44) throw new IOException("Invalid save snapshot size");
+        byte[] all = new byte[(int) length];
+        try (InputStream in = new FileInputStream(snapshot)) { readFully(in, all); }
+        if (!Arrays.equals(Arrays.copyOf(all, 8), MAGIC)) throw new IOException("Invalid save snapshot magic");
+        long indexSize = ByteBuffer.wrap(all, 8, 4).order(ByteOrder.LITTLE_ENDIAN).getInt() & 0xffffffffL;
+        if (indexSize > MAX_INDEX || indexSize + 44 > length) throw new IOException("Invalid save index size");
+        String index = new String(all, 12, (int) indexSize, StandardCharsets.UTF_8);
+        List<Object[]> meta = parseIndex(index);
+        if (meta.isEmpty() || meta.size() > MAX_NODES) throw new IOException("Invalid save node count");
+        long total = 0; int pos = 12 + (int) indexSize;
+        for (Object[] m : meta) {
+            String path = (String) m[0]; boolean dir = (Boolean) m[1]; long bytes = (Long) m[2];
+            if (!validPath(path) || bytes > MAX_FILE || (dir && bytes != 0)) throw new IOException("Invalid save entry");
+            total += bytes; if (total > MAX_TOTAL) throw new IOException("Save quota exceeded");
+            if (pos + bytes > all.length - 32) throw new IOException("Save payload length mismatch");
+            if (entries.put(path, new Entry(dir, Arrays.copyOfRange(all, pos, pos + (int) bytes))) != null) throw new IOException("Duplicate save path");
+            pos += (int) bytes;
+        }
+        if (length != 12 + indexSize + total + 32) throw new IOException("Save payload length mismatch");
+        MessageDigest sha = sha256(); sha.update(all, 0, all.length - 32);
+        if (!Arrays.equals(sha.digest(), Arrays.copyOfRange(all, all.length - 32, all.length))) throw new IOException("Save snapshot checksum mismatch");
+        Entry root = entries.get(ROOT);
+        if (root == null || !root.directory) throw new IOException("Save root is missing");
+        for (String path : entries.keySet()) {
+            if (path.equals(ROOT)) continue;
+            Entry parent = entries.get(path.substring(0, path.lastIndexOf('/')));
+            if (parent == null || !parent.directory) throw new IOException("Invalid save parent");
+        }
+        return entries;
+    }
+
+    /** Writes the snapshot through a temporary file and an atomic rename. */
+    static void save(File snapshot, TreeMap<String, Entry> entries) throws IOException {
+        long total = 0;
+        for (Entry e : entries.values()) total += e.data.length;
+        if (entries.size() > MAX_NODES || total > MAX_TOTAL) throw new IOException("Save quota exceeded");
+        StringBuilder json = new StringBuilder("[");
+        boolean first = true;
+        for (Map.Entry<String, Entry> e : entries.entrySet()) {
+            if (!first) json.append(','); first = false;
+            json.append("{\"path\":\"").append(e.getKey()).append("\",\"directory\":").append(e.getValue().directory).append(",\"bytes\":").append(e.getValue().data.length).append('}');
+        }
+        byte[] index = json.append(']').toString().getBytes(StandardCharsets.UTF_8);
+        if (index.length > MAX_INDEX) throw new IOException("Save index exceeds quota");
+        ByteArrayOutputStream body = new ByteArrayOutputStream((int) total + index.length + 44);
+        body.write(MAGIC);
+        body.write(ByteBuffer.allocate(4).order(ByteOrder.LITTLE_ENDIAN).putInt(index.length).array());
+        body.write(index);
+        for (Entry e : entries.values()) body.write(e.data);
+        byte[] payload = body.toByteArray();
+        File temporary = new File(snapshot.getPath() + ".mods.partial");
+        try {
+            try (FileOutputStream out = new FileOutputStream(temporary)) {
+                out.write(payload); out.write(sha256().digest(payload)); out.getFD().sync();
+            }
+            Files.move(temporary.toPath(), snapshot.toPath(), StandardCopyOption.ATOMIC_MOVE, StandardCopyOption.REPLACE_EXISTING);
+        } finally { if (temporary.exists() && !temporary.delete()) temporary.deleteOnExit(); }
+    }
+
+    /**
+     * Finds where the game keeps mods without guessing: an existing "Mods" directory (shortest path
+     * wins), else "Mods" beside an existing "SaveData" directory. Throws if the game has not created
+     * its save folders yet (launch the game once first).
+     */
+    static String findModsRoot(Map<String, Entry> entries) throws IOException {
+        String best = null;
+        for (Map.Entry<String, Entry> e : entries.entrySet())
+            if (e.getValue().directory && e.getKey().endsWith("/Mods") && (best == null || e.getKey().length() < best.length())) best = e.getKey();
+        if (best != null) return best;
+        for (Map.Entry<String, Entry> e : entries.entrySet())
+            if (e.getValue().directory && e.getKey().endsWith("/SaveData") && (best == null || e.getKey().length() < best.length())) best = e.getKey();
+        if (best != null) return best + "/Mods";
+        throw new IOException("The game has not created its save folders yet. Launch the game once, return to the launcher and try again.");
+    }
+
+    /** Imports a mod ZIP. A single top-level folder keeps its name; otherwise fallbackName is used. */
+    static Result importZip(InputStream zip, File snapshot, String fallbackName) throws IOException {
+        TreeMap<String, Entry> entries = load(snapshot);
+        String modsRoot = findModsRoot(entries);
+        List<String> names = new ArrayList<>(); List<byte[]> blobs = new ArrayList<>();
+        long inTotal = 0;
+        try (ZipInputStream in = new ZipInputStream(zip)) {
+            ZipEntry ze; int count = 0;
+            while ((ze = in.getNextEntry()) != null) {
+                if (++count > MAX_ZIP_ENTRIES) throw new IOException("Mod ZIP has too many entries");
+                String name = ze.getName();
+                if (ze.isDirectory()) { cleanName(name.endsWith("/") ? name.substring(0, name.length() - 1) : name); continue; }
+                String clean = cleanName(name);
+                byte[] data = readBounded(in, MAX_FILE, clean);
+                inTotal += data.length; if (inTotal > MAX_TOTAL) throw new IOException("Mod is larger than the 32 MiB save quota");
+                names.add(clean); blobs.add(data);
+            }
+        }
+        if (names.isEmpty()) throw new IOException("The ZIP contains no files");
+        String top = names.get(0).contains("/") ? names.get(0).substring(0, names.get(0).indexOf('/')) : null;
+        for (String n : names) if (top != null && !n.startsWith(top + "/")) top = null;
+        String modName = top != null ? top : cleanName(fallbackName);
+        if (modName.contains("/")) throw new IOException("Invalid mod name");
+        String modRoot = modsRoot + "/" + modName;
+        // Replace any earlier copy of this mod, then add the new tree.
+        removeTree(entries, modRoot);
+        ensureDirs(entries, modRoot);
+        long bytes = 0;
+        for (int i = 0; i < names.size(); i++) {
+            String rel = top != null ? names.get(i).substring(top.length() + 1) : names.get(i);
+            String path = modRoot + "/" + rel;
+            if (!validPath(path)) throw new IOException("Unsafe path in ZIP: " + names.get(i));
+            ensureDirs(entries, path.substring(0, path.lastIndexOf('/')));
+            Entry old = entries.get(path);
+            if (old != null) throw new IOException("Duplicate or conflicting path in ZIP: " + names.get(i));
+            entries.put(path, new Entry(false, blobs.get(i))); bytes += blobs.get(i).length;
+        }
+        save(snapshot, entries);   // validates node/size quotas before replacing the old file
+        return new Result(modsRoot, modName, names.size(), bytes);
+    }
+
+    /** Names of installed mod folders (direct children of the Mods directory). */
+    static List<String> listMods(File snapshot) throws IOException {
+        TreeMap<String, Entry> entries = load(snapshot);
+        String root; try { root = findModsRoot(entries); } catch (IOException none) { return new ArrayList<>(); }
+        List<String> result = new ArrayList<>();
+        for (Map.Entry<String, Entry> e : entries.entrySet())
+            if (e.getValue().directory && e.getKey().startsWith(root + "/") && e.getKey().indexOf('/', root.length() + 1) < 0) result.add(e.getKey().substring(root.length() + 1));
+        return result;
+    }
+
+    static boolean removeMod(File snapshot, String modName) throws IOException {
+        if (modName.isEmpty() || modName.contains("/")) throw new IOException("Invalid mod name");
+        TreeMap<String, Entry> entries = load(snapshot);
+        String path = findModsRoot(entries) + "/" + modName;
+        if (!entries.containsKey(path)) return false;
+        removeTree(entries, path); save(snapshot, entries); return true;
+    }
+
+    private static void removeTree(TreeMap<String, Entry> entries, String root) {
+        entries.keySet().removeIf(p -> p.equals(root) || p.startsWith(root + "/"));
+    }
+    private static void ensureDirs(TreeMap<String, Entry> entries, String dir) throws IOException {
+        StringBuilder path = new StringBuilder();
+        for (String part : dir.substring(1).split("/")) {
+            path.append('/').append(part);
+            Entry e = entries.get(path.toString());
+            if (e == null) entries.put(path.toString(), new Entry(true, new byte[0]));
+            else if (!e.directory) throw new IOException("A file blocks the folder " + path);
+        }
+    }
+    /** Rejects anything the Rust store would reject, plus quotes and control characters. */
+    private static String cleanName(String name) throws IOException {
+        if (name.isEmpty() || name.length() > 512 || name.startsWith("/") || name.contains("\\") || name.contains("\0"))
+            throw new IOException("Unsafe path in ZIP: " + name);
+        for (int i = 0; i < name.length(); i++) { char c = name.charAt(i); if (c < 0x20 || c == 0x7f || c == '"') throw new IOException("Unsafe path in ZIP: " + name); }
+        for (String part : name.split("/", -1)) if (part.isEmpty() || part.equals(".") || part.equals("..")) throw new IOException("Unsafe path in ZIP: " + name);
+        return name;
+    }
+    private static boolean validPath(String path) {
+        if (!(path.equals(ROOT) || path.startsWith(ROOT + "/")) || path.length() > 4096 || path.contains("\\") || path.contains("\0")) return false;
+        for (String part : path.substring(1).split("/", -1)) if (part.isEmpty() || part.equals(".") || part.equals("..")) return false;
+        return true;
+    }
+    private static byte[] readBounded(InputStream in, int limit, String name) throws IOException {
+        ByteArrayOutputStream out = new ByteArrayOutputStream(); byte[] buffer = new byte[65536]; int n;
+        while ((n = in.read(buffer)) != -1) { if (out.size() + n > limit) throw new IOException(name + " is larger than the 8 MiB per-file save limit"); out.write(buffer, 0, n); }
+        return out.toByteArray();
+    }
+    private static void readFully(InputStream in, byte[] target) throws IOException {
+        int off = 0; while (off < target.length) { int n = in.read(target, off, target.length - off); if (n < 0) throw new IOException("Truncated save snapshot"); off += n; }
+    }
+    private static MessageDigest sha256() { try { return MessageDigest.getInstance("SHA-256"); } catch (NoSuchAlgorithmException e) { throw new AssertionError(e); } }
+
+    /** Strict reader for the flat index the Rust side writes: [{"path":s,"directory":b,"bytes":n},...]. */
+    private static List<Object[]> parseIndex(String s) throws IOException {
+        List<Object[]> out = new ArrayList<>(); int[] p = {0};
+        ws(s, p); expect(s, p, '['); ws(s, p);
+        if (peek(s, p) == ']') { p[0]++; return out; }
+        while (true) {
+            ws(s, p); expect(s, p, '{'); String path = null; Boolean dir = null; Long bytes = null;
+            while (true) {
+                ws(s, p); String key = str(s, p); ws(s, p); expect(s, p, ':'); ws(s, p);
+                if (key.equals("path")) path = str(s, p);
+                else if (key.equals("directory")) { if (s.startsWith("true", p[0])) { dir = true; p[0] += 4; } else if (s.startsWith("false", p[0])) { dir = false; p[0] += 5; } else throw bad(); }
+                else if (key.equals("bytes")) { int st = p[0]; while (p[0] < s.length() && Character.isDigit(s.charAt(p[0]))) p[0]++; if (st == p[0] || p[0] - st > 10) throw bad(); bytes = Long.parseLong(s.substring(st, p[0])); }
+                else throw bad();
+                ws(s, p); char c = peek(s, p); p[0]++;
+                if (c == '}') break; if (c != ',') throw bad();
+            }
+            if (path == null || dir == null || bytes == null) throw bad();
+            out.add(new Object[]{path, dir, bytes}); ws(s, p); char c = peek(s, p); p[0]++;
+            if (c == ']') break; if (c != ',') throw bad();
+        }
+        ws(s, p); if (p[0] != s.length()) throw bad(); return out;
+    }
+    private static String str(String s, int[] p) throws IOException {
+        expect(s, p, '"'); StringBuilder b = new StringBuilder();
+        while (true) {
+            char c = peek(s, p); p[0]++;
+            if (c == '"') return b.toString();
+            if (c != '\\') { b.append(c); continue; }
+            char e = peek(s, p); p[0]++;
+            if (e == '"' || e == '\\' || e == '/') b.append(e);
+            else if (e == 'u') { b.append((char) Integer.parseInt(s.substring(p[0], p[0] + 4), 16)); p[0] += 4; }
+            else throw bad();
+        }
+    }
+    private static void ws(String s, int[] p) { while (p[0] < s.length() && Character.isWhitespace(s.charAt(p[0]))) p[0]++; }
+    private static char peek(String s, int[] p) throws IOException { if (p[0] >= s.length()) throw bad(); return s.charAt(p[0]); }
+    private static void expect(String s, int[] p, char c) throws IOException { if (peek(s, p) != c) throw bad(); p[0]++; }
+    private static IOException bad() { return new IOException("Invalid save index"); }
+}
